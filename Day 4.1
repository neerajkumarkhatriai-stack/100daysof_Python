import random

rock = ("""
    _______
---'   ____)
      (_____)
      (_____)
      (____)
---.__(___)
""")

paper = ("""
     _______
---'    ____)____
           ______)
          _______)
         _______)
---.__________)
""")

scissors = ("""
    _______
---'   ____)____
          ______)
       __________)
      (____)
---.__(___)
""")

rps = [rock, paper, scissors]

computer_choice = random.randrange(len(rps))

user_choice = int(input(
    "What do you choose? Type 0 for Rock, 1 for Paper or 2 for Scissors.\n"
))

if user_choice < 0 or user_choice >= 3:
    print("Invalid entry. Please choose 0, 1, or 2.")

else:
    print(f"User Choice:\n{rps[user_choice]}")
    print(f"Computer Choice:\n{rps[computer_choice]}")

    if computer_choice == user_choice:
        print("It's a Draw")

    elif (
        (user_choice == 0 and computer_choice == 2) or
        (user_choice == 1 and computer_choice == 0) or
        (user_choice == 2 and computer_choice == 1)
    ):
        print("User wins!")

    else:
        print("Computer wins!")
